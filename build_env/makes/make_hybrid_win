clean:
	@printf "Cleaning up\n"
	@rm -f *~
	@rm -f *.o
	@rm -f *.exe
	@rm -f HeMPS
	@rm -f Injector*
	@rm -f ../modelsim.ini
	@rm -rf ../work
	@rm -rf work
	@rm -rf ../transcript
	@rm -rf ../log/*
	@rm -rf ../debug/*.txt
